{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio project",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "role",
    "summary",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "live",
        "prototype",
        "experiment",
        "archived",
        "contribution"
      ]
    },
    "role": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "demo",
              "repository",
              "report",
              "image",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "conditions": {
            "type": "string"
          }
        }
      }
    }
  }
}
